{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Forest",
	"description": "Deep green with warm neutrals. Rural without resorting to tweed and tartan.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#ffffff", "name": "White" },
				{ "slug": "surface", "color": "#f1f4ef", "name": "Surface" },
				{ "slug": "surface-2", "color": "#dfe7db", "name": "Deep surface" },
				{ "slug": "ink", "color": "#16241a", "name": "Ink" },
				{ "slug": "ink-soft", "color": "#243527", "name": "Soft ink" },
				{ "slug": "muted", "color": "#5f6f61", "name": "Muted" },
				{ "slug": "line", "color": "#d6e0d1", "name": "Line" },
				{ "slug": "accent", "color": "#2f6b3f", "name": "Accent" },
				{ "slug": "accent-deep", "color": "#22502f", "name": "Deep accent" },
				{ "slug": "highlight", "color": "#c08a2e", "name": "Highlight" }
			]
		},
		"custom": {
			"radius": "12px",
			"radiusSmall": "7px",
			"headingFamily": "var(--wp--preset--font-family--sans)",
			"headingWeight": "640",
			"headingTracking": "-0.02em"
		}
	}
}
