msgid "A city agency. Hard edges, plenty of white, one accent."
msgstr ""

#: inc/designs.php:157
msgid "Dark throughout with gold detail. Photographs look expensive on it."
msgstr ""

#: inc/designs.php:158
msgid "Properties moving behind the search, in blue and white."
msgstr ""

#: inc/designs.php:159
msgid "Warm terracotta and cream. Suits Mediterranean stock particularly."
