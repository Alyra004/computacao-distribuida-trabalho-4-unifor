#: styles/coastal.json
msgctxt "Style variation name"
msgid "Coastal"
msgstr "Coastal"

#: styles/coastal.json
msgctxt "Style variation description"
msgid "The default. Warm sand and deep sea, generous photography - built for agencies selling somewhere with a coastline."
msgstr "El estilo por defecto. Arena cálida y mar profundo, con fotografía generosa: hecho para agencias que venden en un sitio con costa."

#: styles/forest.json
msgctxt "Style variation name"
msgid "Forest"
msgstr "Forest"

#: styles/forest.json
msgctxt "Style variation description"
msgid "Deep green with warm neutrals. Rural without resorting to tweed and tartan."
msgstr "Verde intenso con neutros cálidos. Rural sin recurrir al tweed y al tartán."

#: styles/harbour.json
msgctxt "Style variation name"
msgid "Harbour"
msgstr "Harbour"

#: styles/harbour.json
msgctxt "Style variation description"
msgid "Slate and sea green, cool and quiet, with a lot of air between things."
msgstr "Pizarra y verde mar, frío y sobrio, con mucho aire entre los elementos."

#: styles/heritage.json
msgctxt "Style variation name"
msgid "Heritage"
msgstr "Heritage"

#: styles/heritage.json
msgctxt "Style variation description"
msgid "A traditional high street agency. Serif headings, forest and claret, rounded but restrained."
msgstr "Una agencia tradicional de calle principal. Titulares con serifa, verde bosque y burdeos, redondeado pero contenido."

#: styles/heritage.json
#: styles/sandstone.json
msgctxt "Color name"
msgid "Paper"
msgstr "Paper"

#: styles/ink.json
msgctxt "Style variation name"
msgid "Ink"
msgstr "Tinta"

#: styles/ink.json
msgctxt "Style variation description"
msgid "Near black on white, no ornament, one red. The photographs carry the whole page."
msgstr "Casi negro sobre blanco, sin adornos, un solo rojo. Las fotografías sostienen toda la página."

#: styles/metropolitan.json
msgctxt "Style variation name"
msgid "Metropolitan"
msgstr "Metropolitan"

#: styles/metropolitan.json
msgctxt "Style variation description"
msgid "Monochrome and tight, for a city agency. Square corners, one sharp accent, headings set close."
msgstr "Monocromo y compacto, para una agencia de ciudad. Esquinas rectas, un acento marcado, titulares muy juntos."

#: styles/nocturne.json
msgctxt "Style variation name"
msgid "Nocturne"
msgstr "Nocturne"

#: styles/nocturne.json
msgctxt "Style variation description"
msgid "Dark, for agencies selling at the top of the market. Photographs carry the page and the interface gets out of the way."
msgstr "Oscuro, para agencias que venden en la gama más alta. Las fotografías sostienen la página y la interfaz se aparta."

#: styles/nocturne.json
msgctxt "Color name"
msgid "Night"
msgstr "Night"

#: styles/sandstone.json
msgctxt "Style variation name"
msgid "Sandstone"
msgstr "Sandstone"

#: styles/sandstone.json
msgctxt "Style variation description"
msgid "Warm stone, soft corners and a muted olive accent. Reads as established rather than new."
msgstr "Piedra cálida, esquinas suaves y un acento oliva apagado. Se lee como asentado en lugar de nuevo."

#: styles/terracotta.json
msgctxt "Style variation name"
msgid "Terracotta"
msgstr "Terracotta"

#: styles/terracotta.json
msgctxt "Style variation description"
msgid "Clay, cream and a deep teal. Made for Mediterranean stock and warm photography."
msgstr "Arcilla, crema y un turquesa profundo. Hecho para cartera mediterránea y fotografía cálida."

#: styles/terracotta.json
msgctxt "Color name"
msgid "Cream"
msgstr "Crema"

